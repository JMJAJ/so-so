{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexus-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "server", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "nexus-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "3000"],
      "port": 3000
    }
  ]
}
