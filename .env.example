# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Server-side Supabase (for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Python Backend Configuration
# The Python FastAPI server runs on port 8000 by default
# Make sure it's running before starting the frontend

# Optional: Custom Python server URL
# PYTHON_API_URL=http://localhost:8000
