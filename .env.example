# NEXUS reads these from .env (project root or server/.env). All are optional;
# keys can also be entered in the app under Settings (stored encrypted locally).

# LLM provider keys: set the one you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional: company-specific news history (free tier at finnhub.io).
FINNHUB_API_KEY=

# Optional: override where the SQLite database lives.
# NEXUS_DB_PATH=server/data/nexus_v3.db
